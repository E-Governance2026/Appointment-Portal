# ─── Appointment Portal frontend environment ─────────────────────────────────
# Copy to .env (or .env.local) and adjust. Vite only exposes VITE_* vars.

# Data source for the service layer:
#   mock     — in-memory demo data (default; no backend needed)
#   supabase — talk to the real Node backend at VITE_API_BASE_URL
VITE_DATA_SOURCE=mock

# Base URL of the backend API (used when VITE_DATA_SOURCE=supabase).
VITE_API_BASE_URL=http://localhost:4000
