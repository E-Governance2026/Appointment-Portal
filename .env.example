# ─── Appointment Portal Frontend Environment Configuration ────────────────────
# Copy to .env (or .env.local) and adjust.
# NOTE: Vite only exposes environment variables prefixed with VITE_* to the browser.

# ── Data Source & Service Layer ──────────────────────────────────────────────
# Data source for the frontend service layer:
#   mock     — in-memory mock repositories (client-only demo data; no backend needed)
#   supabase — connects to the hardened Node.js + Express backend at VITE_API_BASE_URL
VITE_DATA_SOURCE=mock

# Base URL of the backend API (used when VITE_DATA_SOURCE=supabase).
# In production, must be an HTTPS URL.
VITE_API_BASE_URL=http://localhost:4000

# ── Demo UI Flags ────────────────────────────────────────────────────────────
# Set to 'false' in production builds to hide the demo user switch dropdown and mock badges.
VITE_DEMO_SWITCHER=false
