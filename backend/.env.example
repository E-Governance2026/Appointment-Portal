# ─── Appointment Portal Backend Environment Configuration ──────────────────────
# Copy this file to backend/.env and fill in production secrets.
# backend/.env is gitignored and MUST NEVER be committed to source control.

# ── Server & Runtime Environment ─────────────────────────────────────────────
# Set to 'production' in deployed environments (enforces all fail-fast security rules).
NODE_ENV=development
PORT=4000

# Number of reverse proxy hops in front of the application (e.g. 1 behind Nginx/Cloudflare).
# In production, this enables secure client IP resolution and HTTPS redirection.
TRUST_PROXY=0

# ── Transport, CORS & CSRF ───────────────────────────────────────────────────
# Allowed browser origin(s) for CORS & CSRF origin checks (comma-separated).
# Wildcards are rejected. In production, set this to your exact HTTPS production domain(s).
ALLOWED_ORIGINS=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cookie security flag. In production this MUST be true (browser requires Secure for __Host-sid).
# Defaults to true in production, false in development.
COOKIE_SECURE=false

# ── Session & Idle Timeout Policy ────────────────────────────────────────────
# Seconds of inactivity before the server terminates the session (default 3 minutes = 180s).
SESSION_IDLE_TIMEOUT_SECONDS=180
# Warn the user this many seconds before idle timeout triggers (default 30s before expiry = at 2m30s).
SESSION_WARNING_SECONDS=30
# Hard cap on session lifetime regardless of user activity (default 8 hours = 28800s).
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
# Cryptographic session secret used for signing session identifiers (minimum 32 characters in production).
SESSION_SECRET=dev-session-secret-change-in-production-must-be-32-chars

# ── Demo Features & Guardrails ───────────────────────────────────────────────
# Demo switcher and test credential bypass. MUST NEVER be true in production!
DEMO_ROLE_SWITCHER=false

# ── Database & Supabase Credentials ──────────────────────────────────────────
# SUPABASE_URL and SUPABASE_ANON_KEY are safe to expose to browser.
# SUPABASE_SERVICE_ROLE_KEY is SECRET — server-only, full database access.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct PostgreSQL database URL for migrations and health checks.
# In production, TLS is mandatory (must include sslmode=require or ssl=true).
DATABASE_URL=postgresql://app_portal_runtime:your-secure-password@your-db-host:5432/postgres?sslmode=require

# ── Encryption at Rest & Key Rotation ────────────────────────────────────────
# Active AES-256-GCM symmetric key (32 bytes = 64 hex characters or 32 raw characters).
# Used to encrypt TOTP secrets, recovery codes, and OAuth tokens at rest.
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Active Key Identifier tagged to new ciphertexts (format: keyId:iv:tag:cipher).
ACTIVE_KEY_ID=v1
# Key rotation fallback ring (comma-separated list of historical keyId:keyHex pairs).
# Allows seamless zero-downtime key rotation while retaining read access to older data.
APP_ENCRYPTION_KEY_RING=

# ── Authentication & Identity Hardening ──────────────────────────────────────
# Multi-Factor Authentication (TOTP + Recovery codes) feature flag (default true).
FEATURES_MFA=true
# Self-service email password reset feature flag (default false; admin password reset workflow recommended).
FEATURES_SELF_SERVICE_RESET=false
# Allowed Google workspace domains for OAuth sign-in (comma-separated).
GOOGLE_ALLOWED_DOMAINS=university.edu,paruluniversity.ac.in
# Optional Google OAuth client configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── File Uploads & Antivirus Pipeline ────────────────────────────────────────
# Maximum upload file size in megabytes per file (default 10 MB).
MAX_FILE_SIZE_MB=10
# Maximum number of document attachments allowed per appointment (default 5).
MAX_FILES_PER_APPOINTMENT=5
# Maximum aggregate upload storage quota per user in megabytes (default 50 MB).
MAX_STORAGE_PER_USER_MB=50

# ClamAV daemon TCP scanning integration.
# When true, scans incoming uploads over TCP streaming (zINSTREAM) to clamd.
# In development, false activates NoOpScanner with EICAR detection.
# In production, a warning is logged if disabled.
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
