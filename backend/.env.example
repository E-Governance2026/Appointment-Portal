# ─── Appointment Portal backend environment ──────────────────────────────────
# Copy this file to backend/.env and fill in the real values.
# backend/.env is gitignored and must never be committed.

# Server
NODE_ENV=development
PORT=4000

# Supabase (from your Supabase project settings → API)
# SUPABASE_URL and SUPABASE_ANON_KEY are safe to expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY is SECRET — server-only, full database access.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
