{
  "name": "appointment-portal-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Node + Supabase API for the Appointment Portal",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest --run",
    "test:security": "vitest run src/tests/authHarden.test.ts src/tests/authzHarden.test.ts src/tests/sessionHarden.test.ts src/tests/securityHarden.test.ts",
    "scan:secrets": "tsx src/scripts/scan-secrets.ts",
    "security:scan": "npm --prefix .. run security:scan"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "~5.6.2",
    "vitest": "^5.0.5"
  }
}
